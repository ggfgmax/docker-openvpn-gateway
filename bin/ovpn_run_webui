#!/bin/bash

#
# 启动 Web 管理界面
#

if [ "$DEBUG" == "1" ]; then
  set -x
fi

echo "=========================================="
echo "  启动 OpenVPN Web 管理界面"
echo "=========================================="
echo ""
echo "Web 界面地址: http://0.0.0.0:8080"
echo "默认用户名: ${WEBUI_USERNAME:-admin}"
echo "默认密码: ${WEBUI_PASSWORD:-openvpn}"
echo ""
echo "⚠️ 强烈建议修改默认密码！"
echo "   使用环境变量: WEBUI_USERNAME 和 WEBUI_PASSWORD"
echo "=========================================="
echo ""

# 启动 Flask 应用
cd /opt/openvpn-webui
exec python3 app.py

