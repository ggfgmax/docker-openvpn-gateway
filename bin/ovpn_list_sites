#!/bin/bash

#
# 列出所有配置的站点及其状态（支持 OpenVPN 和 WireGuard）
#

if [ "$DEBUG" == "1" ]; then
  set -x
fi

set -e

SITE_DIR="$OPENVPN/sites"
WG_DIR="$OPENVPN/wireguard"
PID_DIR="$OPENVPN/site-pids"

echo "=========================================="
echo "  Site-to-Site VPN 站点列表"
echo "=========================================="
echo ""

site_found=false

# 列出 OpenVPN 站点
if [ -d "$SITE_DIR" ]; then
    for info_file in "$SITE_DIR"/*.info; do
        if [ -f "$info_file" ]; then
            site_found=true
            source "$info_file"
            
            pid_file="$PID_DIR/${SITE_NAME}.pid"
            
            # 检查状态
            if [ -f "$pid_file" ] && kill -0 $(cat "$pid_file") 2>/dev/null; then
                status="运行中 (PID: $(cat "$pid_file"))"
            else
                status="未运行"
            fi
            
            echo "站点名称: $SITE_NAME"
            echo "  类型: OpenVPN"
            echo "  远程主机: $REMOTE_HOST:$REMOTE_PORT ($PROTOCOL)"
            echo "  远程网段: $REMOTE_SUBNET"
            echo "  状态: $status"
            echo "  创建时间: $CREATED_AT"
            echo ""
        fi
    done
fi

# 列出 WireGuard 站点
if [ -d "$WG_DIR" ]; then
    for info_file in "$WG_DIR"/*.info; do
        if [ -f "$info_file" ]; then
            site_found=true
            source "$info_file"
            
            wg_interface="wg-${SITE_NAME}"
            
            # 检查接口状态
            if ip link show "$wg_interface" &>/dev/null; then
                status="运行中"
                # 获取额外状态信息
                if command -v wg &>/dev/null; then
                    wg_status=$(wg show "$wg_interface" 2>/dev/null || echo "")
                    if [ -n "$wg_status" ]; then
                        status="$status (已连接)"
                    fi
                fi
            else
                status="未运行"
            fi
            
            echo "站点名称: $SITE_NAME"
            echo "  类型: WireGuard"
            echo "  远程端点: $ENDPOINT"
            echo "  远程网段: $REMOTE_SUBNET"
            echo "  本地端口: $PORT"
            echo "  状态: $status"
            echo "  创建时间: $CREATED_AT"
            echo ""
        fi
    done
fi

if [ "$site_found" = false ]; then
    echo "未找到站点配置"
fi

